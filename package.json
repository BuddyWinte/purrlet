{
  "name": "purrlet",
  "version": "2.0.0",
  "description": "A lightweight headless canvas drawing engine for building interactive drawing tools and websites. meow",
  "type": "module",
  "main": "./dist/purrlet.mjs",
  "module": "./dist/purrlet.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "rollup -c --watch",
    "build": "rollup -c",
    "test": "bun run build && bun test || echo \"No tests found\"",
    "prepublishOnly": "bun run build",
    "lint": "eslint ."
  },
  "keywords": [
    "drawbox",
    "drawing"
  ],
  "sideEffects": false,
  "author": "BuddyWinte",
  "license": "MIT",
  "homepage": "https://github.com/BuddyWinte/Purrlet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuddyWinte/Purrlet.git"
  },
  "bugs": {
    "url": "https://github.com/BuddyWinte/Purrlet/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/BuddyWinte"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "eslint": "^9.0.0",
    "prettier": "^3.8.1",
    "rollup": "^4.57.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
