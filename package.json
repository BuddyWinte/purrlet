{
    "name": "purrlet",
    "version": "2.1.1",
    "private": false,
    "description": "A lightweight, dependency-free, headless canvas drawing engine for the web.",
    "keywords": [
        "drawbox",
        "drawing"
    ],
    "homepage": "https://github.com/BuddyWinte/Purrlet",
    "bugs": {
        "url": "https://github.com/BuddyWinte/Purrlet/issues"
    },
    "license": "Apache-2.0",
    "author": "BuddyWinte",
    "repository": {
        "type": "git",
        "url": "https://github.com/BuddyWinte/Purrlet.git"
    },
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/BuddyWinte"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/purrlet.min.cjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/purrlet.min.mjs",
            "require": "./dist/purrlet.min.cjs"
        },
        "./providers": {
            "types": "./dist/providers.d.ts",
            "import": "./dist/providers.min.mjs",
            "require": "./dist/providers.min.cjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "clean": "rm -rf dist .purrlet-build",
        "dev": "bun run compile && rollup -c --watch",
        "compile": "tsc",
        "build": "bun run clean && bun run compile && rollup -c && rm -rf .purrlet-build",
        "test": "bun test",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "format": "oxfmt .",
        "format:check": "oxfmt . --check",
        "typecheck": "tsc --noEmit",
        "check": "bun run format:check && bun run lint && bun run typecheck && bun run build && bun run test",
        "prepublishOnly": "bun run check",
        "test:serve": "bunx serve . && echo 'You may need to update and build to see updated changes'"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "^20.14.0",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-terser": "^1.0.0",
        "oxfmt": "^0.66.0",
        "oxlint": "^1.81.0",
        "rollup": "^4.57.1",
        "rollup-plugin-dts": "^6.4.1",
        "typescript": "^6.0.3"
    },
    "engines": {
        "bun": ">=1.3.0",
        "node": ">=18"
    },
    "packageManager": "bun@1.4.0"
}
