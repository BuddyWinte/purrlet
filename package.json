{
  "name": "purrlet",
  "version": "1.0.1",
  "description": "A lightweight headless drawbox-style canvas engine for indie sites and creative side projects. simple, fast, flexible.",
  "type": "module",
  "main": "./dist/purrlet.cjs",
  "module": "./dist/purrlet.mjs",
  "types": "./dist/purrlet.d.ts",
  "exports": {
    ".": {
      "types": "./dist/purrlet.d.ts",
      "import": "./dist/purrlet.mjs",
      "require": "./dist/purrlet.cjs",
      "default": "./dist/purrlet.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "rollup -c --watch",
    "build": "rollup -c",
    "test": "npm run build && node --test test/**/*.mjs",
    "prepublishOnly": "npm run build",
    "lint": "eslint ."
  },
  "keywords": [
    "canvas",
    "drawing",
    "drawbox",
    "image-editor",
    "upload",
    "upload-sdk",
    "imgbb",
    "imgur",
    "cloudinary",
    "javascript",
    "library",
    "headless",
    "graphics",
    "indie-dev",
    "side-project",
    "creator-tools"
  ],
  "author": "BuddyWinte",
  "license": "MIT",
  "homepage": "https://github.com/BuddyWinte/Purrlet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuddyWinte/Purrlet.git"
  },
  "bugs": {
    "url": "https://github.com/BuddyWinte/Purrlet/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/BuddyWinte"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "eslint": "^9.0.0",
    "prettier": "^3.8.1",
    "rollup": "^4.57.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
