{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "declaration": true,
        "declarationDir": "./dist/types",
        "importHelpers": false,
        "outDir": "./.purrlet-build",
        "rootDir": "./src",
        "allowJs": false,
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true
    },
    "include": ["src"]
}
